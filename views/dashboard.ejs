<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4>Dashboard</h4>
  <div>
    <a href="/add" class="btn btn-primary btn-sm">➕ Add</a>
    <a href="/export" class="btn btn-success btn-sm">⬇ Export</a>
  </div>
</div>

<!-- SUMMARY -->
<div class="row mb-3">
  <div class="col-md-3 col-6 mb-2">
    <div class="card shadow-sm text-center">
      <div class="card-body">
        <h6>Total Spend</h6>
        <h4 class="text-success">₹ <%= Number(total || 0).toLocaleString('en-IN', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
}) %></h4>
      </div>
    </div>
  </div>

  <div class="col-md-3 col-6 mb-2">
    <div class="card shadow-sm text-center">
      <div class="card-body">
        <h6>Total Transactions</h6>
        <h4><%= count || 0 %></h4>
      </div>
    </div>
  </div>

  <div class="col-md-3 col-6 mb-2">
    <div class="card shadow-sm text-center">
      <div class="card-body">
        <h6>Buy Spend</h6>
        <h4 class="text-primary">
          ₹ <%= Number(buyTotal || 0).toLocaleString('en-IN', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
}) %>
        </h4>
      </div>
    </div>
  </div>

  <div class="col-md-3 col-6 mb-2">
    <div class="card shadow-sm text-center">
      <div class="card-body">
        <h6>Construction Spend</h6>
        <h4 class="text-warning">
          ₹ <%= Number(constructionTotal || 0).toLocaleString('en-IN', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
}) %>
        </h4>
      </div>
    </div>
  </div>
</div>


<!-- PIE CHARTS -->
<div class="row mb-3">
  <div class="col-12">
    <h5 class="mb-3">Buy Expense Breakdown</h5>
  </div>

  <div class="col-md-6 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="text-center">Buy — Paid By</h6>
        <div style="position:relative; height:300px">
          <canvas id="buyPaidByChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="text-center">Buy — Payment Mode</h6>
        <div style="position:relative; height:300px">
          <canvas id="buyModeChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <h5 class="mb-3 mt-2">Construction Expense Breakdown</h5>
  </div>

  <div class="col-md-6 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="text-center">Construction — Paid By</h6>
        <div style="position:relative; height:300px">
          <canvas id="constructionPaidByChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="text-center">Construction — Payment Mode</h6>
        <div style="position:relative; height:300px">
          <canvas id="constructionModeChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- RECENT TABLE -->
<div class="card shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between mb-2">
      <h5>Recent Transactions</h5>
      <a href="/list" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-bordered">
        <thead class="table-dark">
          <tr>
            <th>Date</th>
            <th>Amount</th>
            <th>Purpose</th>
            <th>Paid By</th>
            <th>Mode</th>
            <th>For</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% (data || []).slice(0,10).forEach(t => { %>
          <tr>
            <td><%= new Date(t.payment_date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric'}) %></td>
            <td class="text-success">₹ <%= t.amount %></td>
            <td><%= t.purpose %></td>
            <td><%= t.paid_by === "Other" ? t.other_person : t.paid_by %></td>
            <td><%= t.payment_mode %></td>
            <td><%= t.paid_for %></td>
            <td>
              <!-- Edit Button -->
              <a href="/edit/<%= t.id %>?redirect=/list" class="btn btn-warning btn-sm">✏</a>
              <!-- Delete Button -->
              <form method="POST"
action="/delete/<%= t.id %>?_method=DELETE"
onsubmit="event.preventDefault(); showPasswordModal(this)"
style="display:inline">
    <button class="btn btn-danger btn-sm">🗑</button>
</form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/passwordModal') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
let currentForm = null;

function showPasswordModal(form) {
    currentForm = form;
    document.getElementById("passwordError").innerText = "";
    document.getElementById("modalPassword").value = "";

    const modal = new bootstrap.Modal(document.getElementById('passwordModal'));
    modal.show();
}

document.getElementById('passwordForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const password = document.getElementById('modalPassword').value;
    const errorBox = document.getElementById('passwordError');

    try {
        const formData = new FormData(currentForm);
        formData.append("password", password);

        const res = await fetch(currentForm.action, {
            method: currentForm.method,
            body: new URLSearchParams(formData)
        });

        if (!res.ok) {
            const data = await res.json();
            errorBox.innerText = data.message;
            return;
        }

        // redirect back after success
        const urlParams = new URLSearchParams(currentForm.action.split('?')[1]);
        const redirect = urlParams.get("redirect") || "/";
        window.location.href = redirect;

    } catch (err) {
        errorBox.innerText = "Server error";
    }
});

const charts = <%- chartJson %>;

function renderPieChart(canvasId, chartData) {
    const canvas = document.getElementById(canvasId);

    if (!canvas) return;

    if (!chartData.labels.length) {
        canvas.parentElement.innerHTML =
            '<p class="text-muted text-center mt-5">No transactions available</p>';
        return;
    }

    new Chart(canvas, {
        type: 'pie',
        data: {
            labels: chartData.labels,
            datasets: [{
                data: chartData.values,
                backgroundColor: [
                    '#4e79a7',
                    '#f28e2b',
                    '#e15759',
                    '#76b7b2',
                    '#59a14f',
                    '#edc949',
                    '#af7aa1',
                    '#ff9da7',
                    '#9c755f',
                    '#bab0ab'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const amount = Number(context.raw || 0)
                                .toLocaleString('en-IN', {
                                    style: 'currency',
                                    currency: 'INR',
                                    maximumFractionDigits: 2
                                });

                            return context.label + ': ' + amount;
                        }
                    }
                }
            }
        }
    });
}

renderPieChart('buyPaidByChart', charts.buyPaidBy);
renderPieChart('buyModeChart', charts.buyMode);
renderPieChart('constructionPaidByChart', charts.constructionPaidBy);
renderPieChart('constructionModeChart', charts.constructionMode);
</script>
<%- include('partials/footer') %>
