<div class="card shadow-sm">

<div class="card-body">

<div class="d-flex justify-content-between mb-3">

<h4>All Transactions</h4>

<div>
<a href="/" class="btn btn-secondary btn-sm">⬅ Back</a>
<a href="/add" class="btn btn-primary btn-sm">➕ Add</a>
</div>

</div>


<!-- FILTERS -->

<form method="GET" action="/list" class="row mb-3">

<div class="col-md-3">
<label>From Date</label>
<input type="date" name="from" class="form-control"
value="<%= query?.from || '' %>">
</div>

<div class="col-md-3">
<label>To Date</label>
<input type="date" name="to" class="form-control"
value="<%= query?.to || '' %>">
</div>

<div class="col-md-2">
<label>Paid By</label>
<select name="paid_by" class="form-control">

<option value="">All</option>

<option <%= query?.paid_by=="Sudhakar"?"selected":"" %>>Sudhakar</option>
<option <%= query?.paid_by=="Sowbhagya"?"selected":"" %>>Sowbhagya</option>
<option <%= query?.paid_by=="Sanath"?"selected":"" %>>Sanath</option>
<option <%= query?.paid_by=="Subhash"?"selected":"" %>>Subhash</option>
<option <%= query?.paid_by=="Bank Loan"?"selected":"" %>>Bank Loan</option>
<option <%= query?.paid_by=="Other"?"selected":"" %>>Other</option>

</select>
</div>

<div class="col-md-2">
<label>Sort</label>
<select name="sort" class="form-control">

<option value="date_desc" <%= query?.sort=="date_desc"?"selected":"" %>>
Newest
</option>

<option value="date_asc" <%= query?.sort=="date_asc"?"selected":"" %>>
Oldest
</option>

<option value="amount_desc" <%= query?.sort=="amount_desc"?"selected":"" %>>
High Amount
</option>

<option value="amount_asc" <%= query?.sort=="amount_asc"?"selected":"" %>>
Low Amount
</option>

</select>
</div>

<div class="col-md-2 d-flex align-items-end">
<button class="btn btn-primary w-100">Apply</button>
</div>

</form>


<!-- TABLE -->

<div class="table-responsive">

<table class="table table-striped table-bordered">

<thead class="table-dark">
<tr>
<th>Date</th>
<th>Amount</th>
<th>Purpose</th>
<th>Paid By</th>
<th>Mode</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

<% (data || []).forEach(t => { %>

<tr>

<td>
<%= new Date(t.payment_date).toLocaleDateString('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
}) %>
</td>

<td class="text-success">₹ <%= t.amount %></td>

<td><%= t.purpose %></td>

<td>
<%= t.paid_by === "Other"
? t.other_person
: t.paid_by %>
</td>

<td><%= t.payment_mode %></td>

<td>

<a href="/edit/<%= t.id %>" class="btn btn-warning btn-sm">✏</a>

<form method="POST"
action="/delete/<%= t.id %>?_method=DELETE"
style="display:inline">

<button class="btn btn-danger btn-sm">🗑</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>

</div>