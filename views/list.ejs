<%- include('partials/header') %>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between mb-3">
      <h4>All Transactions</h4>
      <div>
        <a href="/" class="btn btn-secondary btn-sm">⬅ Back</a>
        <a href="/add" class="btn btn-primary btn-sm">➕ Add</a>
      </div>
    </div>

    <!-- FILTERS -->
    <form method="GET" action="/list" class="row mb-3">
      <div class="col-md-3">
        <label>From Date</label>
        <input type="date" name="from" class="form-control" value="<%= query?.from || '' %>">
      </div>
      <div class="col-md-3">
        <label>To Date</label>
        <input type="date" name="to" class="form-control" value="<%= query?.to || '' %>">
      </div>
      <div class="col-md-2">
        <label>Paid By</label>
        <select name="paid_by" class="form-control">
          <option value="">All</option>
          <% ["Sudhakar","Sowbhagya","Sanath","Subhash","Bank Loan","Other"].forEach(p => { %>
            <option <%= query?.paid_by===p?"selected":"" %>><%= p %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label>Sort</label>
        <select name="sort" class="form-control">
          <option value="date_desc" <%= query?.sort=="date_desc"?"selected":"" %>>Newest</option>
          <option value="date_asc" <%= query?.sort=="date_asc"?"selected":"" %>>Oldest</option>
          <option value="amount_desc" <%= query?.sort=="amount_desc"?"selected":"" %>>High Amount</option>
          <option value="amount_asc" <%= query?.sort=="amount_asc"?"selected":"" %>>Low Amount</option>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100">Apply</button>
      </div>
    </form>

    <!-- TABLE -->
    <div class="table-responsive">
      <table class="table table-striped table-bordered">
        <thead class="table-dark">
          <tr>
            <th>Date</th>
            <th>Amount</th>
            <th>Purpose</th>
            <th>Paid By</th>
            <th>Mode</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% (data || []).forEach(t => { %>
          <tr>
            <td><%= new Date(t.payment_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></td>
            <td class="text-success">₹ <%= t.amount %></td>
            <td><%= t.purpose %></td>
            <td><%= t.paid_by==="Other"? t.other_person : t.paid_by %></td>
            <td><%= t.payment_mode %></td>
            <td>
              <a href="/edit/<%= t.id %>?redirect=/list" class="btn btn-warning btn-sm">✏</a>
             <form method="POST"
action="/delete/<%= t.id %>?_method=DELETE"
onsubmit="event.preventDefault(); showPasswordModal(this)"
style="display:inline">
    <button class="btn btn-danger btn-sm">🗑</button>
</form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/passwordModal') %>

<script>
let currentForm = null;

function showPasswordModal(form) {
    currentForm = form;
    document.getElementById("passwordError").innerText = "";
    document.getElementById("modalPassword").value = "";

    const modal = new bootstrap.Modal(document.getElementById('passwordModal'));
    modal.show();
}

document.getElementById('passwordForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const password = document.getElementById('modalPassword').value;
    const errorBox = document.getElementById('passwordError');

    try {
        const formData = new FormData(currentForm);
        formData.append("password", password);

        const res = await fetch(currentForm.action, {
            method: currentForm.method,
            body: new URLSearchParams(formData)
        });

        if (!res.ok) {
            const data = await res.json();
            errorBox.innerText = data.message;
            return;
        }

        // redirect back after success
        const urlParams = new URLSearchParams(currentForm.action.split('?')[1]);
        const redirect = urlParams.get("redirect") || "/";
        window.location.href = redirect;

    } catch (err) {
        errorBox.innerText = "Server error";
    }
});
</script>
<%- include('partials/footer') %>