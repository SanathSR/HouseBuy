<%- include('partials/header') %>

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between mb-3">
        <h4>Add Transaction</h4>
        <div>
          <a href="/" class="btn btn-secondary btn-sm">⬅ Back</a>
        </div>
      </div>

      <form method="POST" action="/add">

        <div class="row">

          <div class="col-md-3">

            <label class="form-label">
              Payment Date
            </label>

            <input type="date" name="payment_date" class="form-control" required>

          </div>


          <div class="col-md-3">

            <label class="form-label">
              Amount
            </label>

            <input type="number" name="amount" class="form-control" required>

          </div>


          <div class="col-md-3">

            <label class="form-label">
              Purpose
            </label>

            <input type="text" name="purpose" class="form-control" required>

          </div>


          <div class="col-md-3">

            <label class="form-label">
              Paid By
            </label>

            <select name="paid_by" id="paid_by" class="form-control">

              <option>Savings Together</option>
              <option>Sudhakar</option>
              <option>Sowbhagya</option>
              <option>Sanath</option>
              <option>Subhash</option>
              <option>Bank Loan</option>
              <option>Other</option>

            </select>

          </div>

        </div>



        <div class="row mt-3">

          <div class="col-md-3">

            <label class="form-label">
              Other Person
            </label>

            <input type="text" name="other_person" id="other_person" class="form-control"
              placeholder="If Paid By Other">

          </div>



          <div class="col-md-3">

            <label class="form-label">
              Payment Mode
            </label>

            <select name="payment_mode" class="form-control">

              <option>Cash</option>
              <option>UPI</option>
              <option>DD</option>
              <option>Cheque</option>
              <option>Bank Transfer</option>

            </select>

          </div>

          <div class="col-md-2">

            <label class="form-label">
              Paid For
            </label>

            <select name="paid_for" class="form-control">

              <option>Buy</option>
              <option>Construction</option>

            </select>

          </div>


          <div class="col-md-4">

            <label class="form-label">
              Comments
            </label>

            <input type="text" name="comments" class="form-control">

          </div>

        </div>


        <div class="mt-4">

          <button class="btn btn-primary">

            💾 Save Transaction

          </button>

          <a href="/" class="btn btn-secondary">

            Cancel

          </a>

        </div>

      </form>
    </div>
  </div>
  <%- include('partials/footer') %>